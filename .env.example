# 用法：把本文件复制一份、改名为 .env，再把下面的值换成你自己的密钥。
# 注意：.env 已被 .gitignore 忽略，不会上传到 GitHub；本文件（.env.example）只是模板，可以上传。

DEEPSEEK_API_KEY=在这里填你的DeepSeek密钥
ZHIPU_API_KEY=在这里填你的智谱密钥

# 可选：检索的最低相关度门槛（余弦相似度，0~1，越大越严格）。默认 0.28
# MIN_SIMILARITY=0.28

# 可选：只有启用 reranker.py 精排时才需要（本地模型路径或模型名）
# RERANKER_MODEL=D:/models/bge-reranker-base
